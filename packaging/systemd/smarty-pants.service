[Unit]
Description=smarty-pants — AI writing assistant
Documentation=https://github.com/thbertoldi/smarty-pants
# Start after the graphical session is available so the GlobalShortcuts
# portal and the user's Wayland socket exist.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# %h expands to the user's home directory at unit-load time.
ExecStart=%h/.cargo/bin/smarty-pants-daemon

# Restart on crash (not on normal exit / SIGTERM).
Restart=on-failure
RestartSec=5

# Log to the journal. Tail with: journalctl --user -u smarty-pants -f
StandardOutput=journal
StandardError=journal

# Tracing filter — bump to debug if you're diagnosing.
Environment=RUST_LOG=info,smarty_pants=info

# For API credentials, configure api_key_file (also managed by the tray),
# or add an EnvironmentFile in a user service override. Shell exports are
# not automatically inherited by an already-running systemd user manager.

# Allow optional larger local presets. The default has 1.1 GB of weights
# and unloads after five idle minutes. API providers load no local weights.
MemoryMax=10G
Nice=5

[Install]
WantedBy=graphical-session.target
